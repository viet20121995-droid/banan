# Banan all-in-one on one server (BizFly). Caddy auto-provisions Let's Encrypt
# certs for every hostname below and:
#   - proxies the API to the backend container
#   - serves the 4 Flutter web builds as static SPAs
#   - serves the static brand site at the root domain
#
# Set BASE_DOMAIN in infra/.env.prod (e.g. banan.com). DNS: point @, www, order,
# api, merchant, kitchen, internal A-records at this server's public IP. A
# hostname whose record is missing cannot get a certificate, so add the record
# BEFORE deploying a Caddyfile that names it.

# ── Flutter SPA serving + cache policy ────────────────────────────────────────
# Flutter web does NOT content-hash main.dart.js / the service worker, so without
# an explicit no-cache the browser keeps serving a STALE build after every deploy
# (this is why "deploy had no effect"). Force-revalidate the entry files (the
# Etag still yields cheap 304s when unchanged); the content-hashed assets under
# assets/ + canvaskit/ keep their normal long caching.
(flutter_spa) {
	encode gzip zstd
	# Match the rewritten path so / and SPA deep links revalidate index.html too.
	route {
		try_files {path} /index.html
		@entry path / /index.html /flutter_service_worker.js /flutter_bootstrap.js /version.json /main.dart.js /manifest.json
		header @entry Cache-Control "no-cache, must-revalidate"
		file_server
	}
}

# ── API ───────────────────────────────────────────────────────────────────────
api.{$BASE_DOMAIN} {
	encode gzip zstd
	reverse_proxy backend:3000
}

# ── Customer ordering app ─────────────────────────────────────────────────────
order.{$BASE_DOMAIN} {
	root * /srv/customer
	# Match the HTML policy even when an older document is revalidated.
	header Referrer-Policy "no-referrer"
	import flutter_spa
}

# ── Brand site (root) ─────────────────────────────────────────────────────────
# Static intro page from web-intro/. The ordering app lived here until it moved
# to order.*, so every path that is not part of this site is an old app link
# (emailed /track/<id>, printed /survey QRs, bookmarks) and is sent across with
# its path intact.
{$BASE_DOMAIN} {
	encode gzip zstd

	# Push subscriptions taken while the app lived on this origin belong to this
	# worker. Keep serving it so those customers still get order updates; the
	# click-through already lands on order.* via CUSTOMER_APP_BASE_URL.
	handle /firebase-messaging-sw.js {
		root * /srv/customer
		file_server
	}

	@site path / /index.html /img/* /favicon.png /robots.txt /sitemap.xml /flutter_service_worker.js
	handle @site {
		root * /srv/intro
		# flutter_service_worker.js here is a kill switch for the old app's worker;
		# it and the page must never be served stale.
		header /flutter_service_worker.js Cache-Control "no-cache, must-revalidate"
		header /index.html Cache-Control "no-cache, must-revalidate"
		header / Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# 302, not 308: browsers cache permanent redirects for good, which would make
	# a rollback of this move impossible for anyone who had already followed one.
	handle {
		redir https://order.{$BASE_DOMAIN}{uri} 302
	}
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} 308
}

# ── Merchant web ──────────────────────────────────────────────────────────────
merchant.{$BASE_DOMAIN} {
	root * /srv/merchant
	import flutter_spa
}

# ── Kitchen web ───────────────────────────────────────────────────────────────
kitchen.{$BASE_DOMAIN} {
	root * /srv/kitchen
	import flutter_spa
}

# ── Internal operations web ───────────────────────────────────────────────────
internal.{$BASE_DOMAIN} {
	root * /srv/internal
	# The public dine-in survey moved to the customer domain. Old printed
	# QRs/bookmarks pointed at internal /survey — send EXACTLY that path (and
	# its trailing-slash twin) there permanently. Admin routes like
	# /survey/reports must NOT match; they stay in this SPA behind ADMIN login.
	@legacy_public_survey path /survey /survey/
	redir @legacy_public_survey https://order.{$BASE_DOMAIN}/survey 308
	import flutter_spa
}
